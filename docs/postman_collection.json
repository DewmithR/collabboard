{
  "info": {
    "name": "CollabBoard API",
    "description": "Requests for every CollabBoard endpoint (auth, boards, columns, tasks), including at least one failure case per resource.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" },
    { "key": "boardId", "value": "b1" },
    { "key": "columnId", "value": "c1" },
    { "key": "taskId", "value": "t1" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register - success",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Amasha\",\n  \"email\": \"amasha@collabboard.dev\",\n  \"password\": \"secret123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Register - failure (email already in use)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Amanda\",\n  \"email\": \"amanda@collabboard.dev\",\n  \"password\": \"secret123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('409 email in use', () => pm.response.to.have.status(409));"] }
            }
          ]
        },
        {
          "name": "Login - success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('token', body.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"amanda@collabboard.dev\",\n  \"password\": \"secret123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login - failure (bad credentials)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"amanda@collabboard.dev\",\n  \"password\": \"wrong-password\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get current user - success",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Get current user - failure (no token)",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Boards",
      "item": [
        {
          "name": "List boards - success",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/boards", "host": ["{{baseUrl}}"], "path": ["boards"] }
          }
        },
        {
          "name": "Create board - success",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"New Board\"\n}" },
            "url": { "raw": "{{baseUrl}}/boards", "host": ["{{baseUrl}}"], "path": ["boards"] }
          }
        },
        {
          "name": "Create board - failure (missing name)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"\"\n}" },
            "url": { "raw": "{{baseUrl}}/boards", "host": ["{{baseUrl}}"], "path": ["boards"] }
          }
        },
        {
          "name": "Get board - success",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/boards/{{boardId}}", "host": ["{{baseUrl}}"], "path": ["boards", "{{boardId}}"] }
          }
        },
        {
          "name": "Get board - failure (not found)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/boards/does-not-exist", "host": ["{{baseUrl}}"], "path": ["boards", "does-not-exist"] }
          }
        }
      ]
    },
    {
      "name": "Columns",
      "item": [
        {
          "name": "List columns - success",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/boards/{{boardId}}/columns",
              "host": ["{{baseUrl}}"],
              "path": ["boards", "{{boardId}}", "columns"]
            }
          }
        },
        {
          "name": "Create column - success",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Review\",\n  \"order\": 3\n}" },
            "url": {
              "raw": "{{baseUrl}}/boards/{{boardId}}/columns",
              "host": ["{{baseUrl}}"],
              "path": ["boards", "{{boardId}}", "columns"]
            }
          }
        },
        {
          "name": "Create column - failure (missing name)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/boards/{{boardId}}/columns",
              "host": ["{{baseUrl}}"],
              "path": ["boards", "{{boardId}}", "columns"]
            }
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "List tasks for board - success",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/boards/{{boardId}}/tasks?columnId={{columnId}}",
              "host": ["{{baseUrl}}"],
              "path": ["boards", "{{boardId}}", "tasks"],
              "query": [{ "key": "columnId", "value": "{{columnId}}" }]
            }
          }
        },
        {
          "name": "List tasks for board - failure (not a board member)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/boards/b2/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["boards", "b2", "tasks"]
            }
          }
        },
        {
          "name": "Create task - success",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Write API docs\",\n  \"columnId\": \"{{columnId}}\",\n  \"boardId\": \"{{boardId}}\",\n  \"priority\": \"high\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/tasks", "host": ["{{baseUrl}}"], "path": ["tasks"] }
          }
        },
        {
          "name": "Create task - failure (title too short)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hi\",\n  \"columnId\": \"{{columnId}}\",\n  \"boardId\": \"{{boardId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/tasks", "host": ["{{baseUrl}}"], "path": ["tasks"] }
          }
        },
        {
          "name": "Update task - success",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"priority\": \"low\"\n}" },
            "url": { "raw": "{{baseUrl}}/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["tasks", "{{taskId}}"] }
          }
        },
        {
          "name": "Update task - failure (not found)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"priority\": \"low\"\n}" },
            "url": { "raw": "{{baseUrl}}/tasks/does-not-exist", "host": ["{{baseUrl}}"], "path": ["tasks", "does-not-exist"] }
          }
        },
        {
          "name": "Delete task - success",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["tasks", "{{taskId}}"] }
          }
        },
        {
          "name": "Delete task - failure (not found)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/tasks/does-not-exist", "host": ["{{baseUrl}}"], "path": ["tasks", "does-not-exist"] }
          }
        }
      ]
    }
  ]
}